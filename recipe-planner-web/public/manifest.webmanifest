{
  "name": "Recipe Planner",
  "short_name": "Recipes",
  "description": "Your recipes, meal plans and shopping list, with cook mode.",
  "start_url": "/recipes",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F4F6F3",
  "theme_color": "#1E4A36",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Import a recipe",
      "url": "/recipes/import"
    },
    {
      "name": "Shopping list",
      "url": "/shopping-list"
    },
    {
      "name": "Plan my week",
      "url": "/plan-week"
    }
  ],
  "share_target": {
    "action": "/recipes/import",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
