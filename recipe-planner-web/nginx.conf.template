# Filled in by the nginx image at container start: only ${API_UPSTREAM} and
# ${API_HOST} are replaced. nginx's own variables ($host, $scheme, ...) are left alone.

# Pass along the original scheme from Azure's ingress; fall back to $scheme locally
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Azure's ingress adds the real client IP as the LAST X-Forwarded-For entry.
    # Take that entry as $remote_addr. Earlier entries can be faked by the client, so they're ignored.
    # Trusting every source is safe here only because Azure's ingress is the only way in.
    set_real_ip_from 0.0.0.0/0;
    set_real_ip_from ::/0;
    real_ip_header X-Forwarded-For;

    # Forward API calls to the API container
    location /api/ {
        # nginx's default 1 MB limit; photos are shrunk in the browser, and the API enforces its own 5 MB cap
        client_max_body_size 6m;
        proxy_pass ${API_UPSTREAM};
        # Azure routes by hostname, so this must name the API app
        proxy_set_header Host ${API_HOST};
        proxy_ssl_server_name on;
        # Overwrite rather than append, so client-supplied entries never reach the API
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;   # includes the port, e.g. localhost:8080 in docker compose
    }

    # Shared-recipe links (/s/<token>): served by the API so social media gets a preview card
    location /s/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host ${API_HOST};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;   # includes the port, e.g. localhost:8080 in docker compose
    }

    # Angular routes: unknown paths fall back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html must never be cached. It names the current build's script files, so a stale copy keeps
    # loading the old app after a deploy (the "close and reopen the tab" problem). "no-cache" still lets the
    # browser keep a copy, it just checks with the server first, which is a tiny request.
    # The fallback above lands here too. Note: a location that adds headers drops the server-level ones,
    # so the security headers are repeated.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # The service worker and its manifest decide when the installed app updates, so the browser must always
    # check them with the server (same idea as index.html above)
    location ~ ^/(ngsw-worker\.js|ngsw\.json|safety-worker\.js|worker-basic\.min\.js|manifest\.webmanifest)$ {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # Angular puts a content hash in built file names (main-AB12CD34.js), so a new build always gets new
    # names. These can safely be cached for a year, which makes repeat visits faster.
    location ~* "^/[a-z0-9-]+-[A-Z0-9]{8}\.(js|css)$" {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}